# Copie este arquivo para ".env" e ajuste. NUNCA envie o .env para o GitHub.
# Para colocar na web, só estes valores mudam (veja docs/COMANDOS.txt).

# development = local  |  production = na web
FLASK_ENV=development

# Chave secreta das sessões. Gere uma com:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-aleatoria-longa-aqui

# Endereço do servidor. Local: 127.0.0.1  |  Web: 0.0.0.0
HOST=127.0.0.1
PORT=5000

# Local: false  |  Web (com HTTPS): true
SESSION_COOKIE_SECURE=false

# ENDEREÇO DO SITE (usado nos links enviados por e-mail)
# Local: http://127.0.0.1:5000  |  Web: https://www.seudominio.com.br
BASE_URL=http://127.0.0.1:5000

# E-MAIL (confirmação de alteração do login do administrador)
# Comentado = os e-mails NÃO são enviados: ficam salvos em backend/instance/outbox/ (.eml)
# Para enviar de verdade pelo Gmail (veja docs/COMANDOS.txt):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=conta.que.envia@gmail.com
# SMTP_PASSWORD=senha-de-app-de-16-letras
# MAIL_FROM=Ajna Terapias <conta.que.envia@gmail.com>

# BANCO DE DADOS
# Vazio/comentado  → SQLite local (arquivo backend/instance/ajna.db)
# Preenchido       → PostgreSQL online, sempre ativo (Neon ou Supabase, plano grátis)
#   Cole aqui o "connection string" do painel do Neon/Supabase:
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
